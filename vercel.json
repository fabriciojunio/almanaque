{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 20
    }
  },
  "rewrites": [
    { "source": "/fontes/:arquivo", "destination": "/public/fontes/:arquivo" },
    { "source": "/estilos/:arquivo", "destination": "/public/estilos/:arquivo" },
    { "source": "/favicon.svg", "destination": "/public/favicon.svg" },
    { "source": "/robots.txt", "destination": "/public/robots.txt" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ],
  "headers": [
    {
      "source": "/fontes/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/estilos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
