# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# A bateria roda em SQLite num arquivo, sem serviço no ar. O CI roda a mesma
# bateria contra MySQL 8, porque produção é MySQL e diferença de dialeto só
# aparece no banco de verdade.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/teste.db"

# Sem Elasticsearch, a busca usa o motor do banco. O teste de integração com
# Elasticsearch se pula sozinho quando não acha o serviço.
ELASTICSEARCH_URL=
