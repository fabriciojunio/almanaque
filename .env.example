# Copie para .env.local e preencha. O .env.local não vai para o repositório.
#
#   cp .env.example .env.local

# Senhas do banco no ambiente local. Não existe valor padrão de propósito:
# subir um MySQL com senha conhecida na porta 3306 da máquina é deixar a
# porta encostada.
DB_SENHA_ROOT=
DB_SENHA=

# Chave da aplicação. Gere com:
#   php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
APP_SECRET=

# Busca. Vazio faz o sistema usar o motor do banco, que é mais pobre e
# suficiente para o guia continuar de pé.
ELASTICSEARCH_URL=http://indice:9200
ELASTICSEARCH_INDICE=almanaque-anuncios

# Imagens do anúncio. Com ARMAZENAMENTO=s3 o upload vai para o bucket e a
# leitura passa a ser por URL assinada.
#
# Para o S3 local do compose (perfil aws):
#   AWS_ENDPOINT=http://localstack:4566
#   AWS_CHAVE=teste
#   AWS_SEGREDO=teste
ARMAZENAMENTO=local
AWS_ENDPOINT=
AWS_REGIAO=sa-east-1
AWS_BUCKET=almanaque-imagens
AWS_CHAVE=
AWS_SEGREDO=
