<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block titulo %}Almanaque{% endblock %}</title>
    <meta name="description" content="{% block descricao %}Almanaque: guias de empresas, classificados e portais de bairro.{% endblock %}">
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="preload" href="{{ asset('fontes/archivo-800-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ asset('fontes/source-serif-4-400-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('estilos/fontes.css') }}">
    <link rel="stylesheet" href="{{ asset('estilos/almanaque.css') }}">
</head>
<body>
<header class="topo">
    <div class="faixa topo-linha">
        <a class="marca" href="{{ path('inicio') }}">Almanaque<em>.</em></a>
        <nav>
            {% block navegacao %}
                <a href="{{ path('inicio') }}">Guias</a>
            {% endblock %}
            {% if app.user %}
                {% if is_granted('ROLE_SUPORTE') %}<a href="{{ path('suporte_fila') }}">Suporte</a>{% endif %}
                <a href="{{ path('sair') }}">Sair</a>
            {% else %}
                <a href="{{ path('entrar') }}">Entrar</a>
            {% endif %}
        </nav>
    </div>
</header>
<div class="regua-dupla"></div>

<main class="faixa">
    {% for rotulo, mensagens in app.flashes %}
        {% for mensagem in mensagens %}
            <p class="aviso {{ rotulo == 'erro' ? 'aviso-erro' }}">{{ mensagem }}</p>
        {% endfor %}
    {% endfor %}

    {% block conteudo %}{% endblock %}
</main>

<footer class="rodape">
    <div class="faixa rodape-linha">
        <span>Almanaque · plataforma de guias e classificados</span>
        <span>{% block rodape_direita %}PHP 8.3 · Symfony 7 · MySQL · Elasticsearch{% endblock %}</span>
    </div>
</footer>
</body>
</html>
