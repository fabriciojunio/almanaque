{% extends 'base.html.twig' %}

{% block titulo %}Chamado {{ chamado.id }} · {{ chamado.titulo }}{% endblock %}

{% block navegacao %}
    <a href="{{ path('inicio') }}">Guias</a>
    <a href="{{ path('suporte_fila') }}">Fila</a>
    <a href="{{ path('suporte_problemas') }}">Problemas conhecidos</a>
{% endblock %}

{% block conteudo %}
    <div class="chamada">
        <p class="etiqueta">
            chamado {{ chamado.id }} · {{ chamado.portal.nome }} · versão {{ chamado.versaoDoPortal }}
            {% if chamado.portal.estaCustomizado %} · portal customizado pelo cliente{% endif %}
        </p>
        <h1>{{ chamado.titulo }}</h1>
        <p>
            <span class="tarja {{ chamado.prioridade.value in ['critica', 'alta'] ? 'tarja-alerta' }}">{{ chamado.prioridade.rotulo }}</span>
            <span class="tarja">{{ chamado.situacao.rotulo }}</span>
            {% if chamado.classificacao %}<span class="tarja tarja-ok">{{ chamado.classificacao.rotulo }}</span>{% endif %}
            {% if chamado.estourouOPrazo %}<span class="tarja tarja-alerta">fora do prazo</span>{% endif %}
        </p>
    </div>

    <div class="duas-colunas conteudo-e-lateral">
        <div>
            <article class="ficha">
                <p class="etiqueta">relato de {{ chamado.autor }}</p>
                <p>{{ chamado.relato|nl2br }}</p>

                <dl class="ficha-dados">
                    <dt>Aberto em</dt>
                    <dd class="dado">{{ chamado.abertoEm|date('d/m/Y H:i') }}</dd>
                    <dt>Requisição</dt>
                    <dd class="dado">{{ chamado.identificadorDeRequisicao ?? '—' }}</dd>
                    <dt>Responsável</dt>
                    <dd>{{ chamado.responsavel ?? 'ninguém assumiu' }}</dd>
                    <dt>Reproduzido</dt>
                    <dd>
                        {% if chamado.foiReproduzido %}
                            sim, {{ chamado.foiReproduzidoEmAmbienteLimpo ? 'em ambiente limpo' : 'só no ambiente do cliente' }}
                        {% else %}
                            ainda não
                        {% endif %}
                    </dd>
                </dl>
            </article>

            <h2 class="etiqueta espaco-acima">Investigação</h2>
            <ul class="lista-anuncios">
                {% for anotacao in chamado.anotacoes %}
                    <li class="anuncio">
                        <div>
                            <p class="categoria">
                                {{ anotacao.autor }} · {{ anotacao.escritaEm|date('d/m H:i') }}
                                {% if not anotacao.ehVisivelAoCliente %} · <strong>interna</strong>{% endif %}
                            </p>
                            <p>{{ anotacao.texto|nl2br }}</p>
                        </div>
                    </li>
                {% else %}
                    <li class="vazio">Nada anotado ainda.</li>
                {% endfor %}
            </ul>

            <form method="post" action="{{ path('suporte_anotar', {id: chamado.id}) }}" class="ficha espaco-acima">
                <input type="hidden" name="_token" value="{{ csrf_token('anotar' ~ chamado.id) }}">
                <label class="campo">
                    <span>Anotar</span>
                    <textarea name="texto" placeholder="A consulta que rodou, a linha do log, a hipótese descartada…"></textarea>
                </label>
                <label class="marcacao">
                    <input type="checkbox" name="visivel" value="1"> mandar para o cliente
                </label>
                <button class="botao" type="submit">Gravar anotação</button>
            </form>
        </div>

        <aside>
            {% if chamado.situacao.value == 'aberto' %}
                <form method="post" action="{{ path('suporte_assumir', {id: chamado.id}) }}" class="espaco-abaixo">
                    <input type="hidden" name="_token" value="{{ csrf_token('assumir' ~ chamado.id) }}">
                    <button class="botao botao-largo" type="submit">Assumir chamado</button>
                </form>
            {% endif %}

            <form method="post" action="{{ path('suporte_triagem', {id: chamado.id}) }}" class="ficha">
                <input type="hidden" name="_token" value="{{ csrf_token('triagem' ~ chamado.id) }}">
                <h2 class="etiqueta">Triagem</h2>

                {% for classificacao in classificacoes %}
                    <label class="opcao">
                        <input type="radio" name="classificacao" value="{{ classificacao.value }}"
                               {{ chamado.classificacao == classificacao ? 'checked' }}>
                        <strong>{{ classificacao.rotulo }}</strong>
                        <span class="opcao-nota">
                            {{ classificacao.explicacao }}
                        </span>
                    </label>
                {% endfor %}

                <hr class="divisor">

                <label class="marcacao">
                    <input type="checkbox" name="reproduzido" value="1" {{ chamado.foiReproduzido ? 'checked' }}>
                    consegui reproduzir
                </label>
                <label class="marcacao">
                    <input type="checkbox" name="ambiente_limpo" value="1" {{ chamado.foiReproduzidoEmAmbienteLimpo ? 'checked' }}>
                    acontece em ambiente limpo
                </label>

                <label class="campo">
                    <span>Problema conhecido</span>
                    <input type="text" name="problema" placeholder="PC-001"
                           value="{{ chamado.problemaConhecido ? chamado.problemaConhecido.codigo }}">
                </label>

                <button class="botao botao-largo" type="submit">Classificar</button>
            </form>

            {% if parecidos %}
                <section class="ficha espaco-acima">
                    <h2 class="etiqueta">Casos parecidos nesta versão</h2>
                    {% for problema in parecidos %}
                        <p class="espaco-acima-curto">
                            <span class="dado">{{ problema.codigo }}</span> · {{ problema.titulo }}
                            {% if problema.contorno %}
                                <span class="opcao-nota">
                                    contorno: {{ problema.contorno }}
                                </span>
                            {% endif %}
                        </p>
                    {% endfor %}
                </section>
            {% endif %}

            {% if chamado.classificacao and chamado.situacao.value != 'resolvido' and chamado.situacao.value != 'fechado' %}
                <form method="post" action="{{ path('suporte_resolver', {id: chamado.id}) }}" class="espaco-acima">
                    <input type="hidden" name="_token" value="{{ csrf_token('resolver' ~ chamado.id) }}">
                    <button class="botao botao-fraco botao-largo" type="submit">Marcar como resolvido</button>
                </form>
            {% endif %}
        </aside>
    </div>
{% endblock %}
